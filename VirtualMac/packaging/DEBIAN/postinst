#!/bin/sh

# Virtual Mac installs into the jailbreak prefix and nowhere else, so that
# removing the package, or removing the jailbreak, removes all of it. The
# layout is declared once below; nothing in this script writes above $prefix
# except /var/db/dhcpd_leases, which Apple's bootpd has compiled in.

set -eu
export PATH=/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin

prefix=/var/jb
runtime=$prefix/usr/libexec/VirtualMac
library=$prefix/var/mobile/VirtualMac
app=$prefix/Applications/VirtualMac.app
tweak_payload=$runtime/bootstrap-common/usr/lib/TweakInject
tweak_dir=$prefix/usr/lib/TweakInject
helper_bin_dir=$prefix/usr/libexec
helper_lib_dir=$prefix/usr/lib
launch_daemons=$prefix/Library/LaunchDaemons
launchctl=$prefix/usr/bin/launchctl
uicache=$prefix/usr/bin/uicache
jbctl=$prefix/usr/bin/jbctl

# Releases up to 1.2.3 kept the runtime and the library outside the prefix.
legacy_library=/var/mobile/Media/VirtualMac

host_version="$(sw_vers -productVersion)"
objc_class_data_auth=0
# iPadOS changed Objective-C class-data authentication during iPadOS 15.
# Detect the actual libobjc implementation: the newer runtime's safe_ro helper is present
# in the system cache's local-symbol companion beginning with 15.4, while 15.3.1 and earlier lack it.
case "$host_version" in
    15.*)
        objc_symbols=/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64e.symbols
        if test -f "$objc_symbols" && \
            LC_ALL=C grep -a -q '_ZNK17class_data_bits_t7safe_roEv' "$objc_symbols"; then
            objc_class_data_auth=1
        fi
        ;;
esac

# This package is rootless-only. A rootful bootstrap has no /var/jb, so there
# is nowhere to install that the package could also clean up again; refuse
# rather than scatter files across the system.
test -x "$jbctl" || jbctl=$prefix/basebin/jbctl
if test ! -x "$jbctl"; then
    echo "Virtual Mac requires a rootless jailbreak that provides jbctl." >&2
    echo "No bootstrap was found at $prefix; refusing to install." >&2
    exit 1
fi

# iOS caches code-signing state on the vnode. Overwriting an already executed
# Mach-O in place can leave the old validation attached to the new bytes and
# produce EAUTH until a signer rewrites it. Install every selected/copied
# executable and dylib through a new inode instead.
replace_file() {
    replace_source="$1"
    replace_destination="$2"
    replace_temporary="${replace_destination}.virtualmac-new"
    cp "$replace_source" "$replace_temporary"
    chmod 755 "$replace_temporary"
    mv -f "$replace_temporary" "$replace_destination"
}

# Install this only after dpkg has removed paths owned by 1.0. The former
# MobileSubstrate path can be a symlink to this canonical directory, so
# unpacking the new file before obsolete-file cleanup is not upgrade-safe.
mkdir -p "$tweak_dir"
replace_file "$tweak_payload/VZKeyboardPassthrough.dylib" \
    "$tweak_dir/VZKeyboardPassthrough.dylib"
cp "$tweak_payload/VZKeyboardPassthrough.plist" \
    "$tweak_dir/VZKeyboardPassthrough.plist.virtualmac-new"
chmod 644 "$tweak_dir/VZKeyboardPassthrough.plist.virtualmac-new"
mv -f "$tweak_dir/VZKeyboardPassthrough.plist.virtualmac-new" \
    "$tweak_dir/VZKeyboardPassthrough.plist"

chmod 755 "$app/VirtualMac" "$app/VZHostCompat.dylib"

vmm_dir="$runtime/payload/VirtualMachine.xpc/Contents/MacOS"
vmm_variant="$vmm_dir/com.apple.Virtualization.VirtualMachine.ipados16"
case "$host_version" in
    14.*)
        vmm_variant="$vmm_dir/com.apple.Virtualization.VirtualMachine.ipados14"
        ;;
    15.*)
        vmm_variant="$vmm_dir/com.apple.Virtualization.VirtualMachine.ipados15"
        ;;
esac
replace_file "$vmm_variant" \
    "$vmm_dir/com.apple.Virtualization.VirtualMachine"
case "$host_version" in
    14.*)
        hook_variant="$runtime/payload/Frameworks/LaunchServicesCompat.dylib.ipados14"
        ;;
    *)
        hook_variant=""
        ;;
esac
if test -n "$hook_variant"; then
    replace_file "$hook_variant" \
        "$runtime/payload/Frameworks/LaunchServicesCompat.dylib"
fi

installation_frameworks="$runtime/payload/Installation.xpc/Contents/Frameworks"
installation_macos="$runtime/payload/Installation.xpc/Contents/MacOS"
installation_variant="$installation_macos/com.apple.Virtualization.Installation.ipados16"
installation_compat_variant="$installation_frameworks/InstallationCompat.dylib.ipados16"
mobile_device_dir="$installation_frameworks/MobileDevice.framework/Versions/A"
mobile_device_variant="$mobile_device_dir/MobileDevice.ipados16"
case "$host_version" in
    14.*)
        installation_variant="$installation_macos/com.apple.Virtualization.Installation.ipados14"
        installation_compat_variant="$installation_frameworks/InstallationCompat.dylib.ipados14"
        mobile_device_variant="$mobile_device_dir/MobileDevice.ipados14"
        ;;
    15.*)
        installation_variant="$installation_macos/com.apple.Virtualization.Installation.ipados15"
        installation_compat_variant="$installation_frameworks/InstallationCompat.dylib.ipados15"
        mobile_device_variant="$mobile_device_dir/MobileDevice.ipados15"
        ;;
esac
if test "$objc_class_data_auth" = 1; then
        installation_variant="$installation_macos/com.apple.Virtualization.Installation.ipados15-auth"
        mobile_device_variant="$mobile_device_dir/MobileDevice.ipados15-auth"
fi
replace_file "$installation_variant" \
    "$installation_macos/com.apple.Virtualization.Installation"
replace_file "$installation_compat_variant" \
    "$installation_frameworks/InstallationCompat.dylib"
replace_file "$mobile_device_variant" "$mobile_device_dir/MobileDevice"

# iPadOS 15.4 and later authenticate class_t::data like Ventura; 15.3.1 and
# earlier do not. The symbol probe above selects the matching form.
if test "$objc_class_data_auth" = 1; then
        replace_file "$helper_lib_dir/libmrc.ipados15-auth.dylib" \
            "$helper_lib_dir/libmrc.dylib"
fi

sharing_variant="$helper_bin_dir/InternetSharing.ipados16"
case "$host_version" in
    14.*)
        sharing_variant="$helper_bin_dir/InternetSharing.ipados14"
        ;;
    15.*)
        sharing_variant="$helper_bin_dir/InternetSharing.ipados15"
        ;;
esac
replace_file "$sharing_variant" "$helper_bin_dir/InternetSharing"
chmod 755 "$helper_bin_dir/InternetSharing" \
    "$helper_lib_dir/libmrc.dylib"

# Select framework binaries from the same package by the actual host ABI.
# The normal payload is the established iPadOS 16 runtime.  Replace only on
# 14/15 with binaries carrying their older Objective-C class-data ABI.
case "$host_version" in
    14.*)
        compat="$runtime/payload/Compatibility/iPadOS14"
        ;;
    15.*)
        compat="$runtime/payload/Compatibility/iPadOS15"
        ;;
esac
if test "$objc_class_data_auth" = 1; then
    compat="$runtime/payload/Compatibility/iPadOS15Authenticated"
fi
case "$host_version" in
    14.*|15.*)
        replace_file "$compat/Hypervisor" \
            "$runtime/payload/Frameworks/Hypervisor.framework/Versions/A/Hypervisor"
        if test "$host_version" != "${host_version#14.}"; then
            replace_file "$compat/HypervisorBigSur" \
                "$runtime/payload/Frameworks/Hypervisor.framework/Versions/A/HypervisorBigSur"
            replace_file "$compat/LibSystemCompat.dylib" \
                "$runtime/payload/Frameworks/LibSystem14"
            replace_file "$compat/vmnet" \
                "$runtime/payload/Frameworks/vmnet.framework/vmnet"
            replace_file "$compat/Netrb" \
                "$runtime/payload/Frameworks/Netrb.framework/Netrb"
        fi
        replace_file "$compat/ParavirtualizedGraphics" \
            "$runtime/payload/Frameworks/ParavirtualizedGraphics.framework/Versions/A/ParavirtualizedGraphics"
        replace_file "$compat/Virtualization" \
            "$runtime/payload/Frameworks/Virtualization.framework/Versions/A/Virtualization"
        replace_file "$compat/MetalSerializer" \
            "$runtime/payload/Frameworks/MetalSerializer.framework/Versions/A/MetalSerializer"
        replace_file "$compat/VideoToolbox" \
            "$runtime/payload/Frameworks/VideoToolbox.framework/VideoToolbox"
        replace_file "$compat/DiskImages2" \
            "$runtime/payload/Frameworks/DiskImages2.framework/Versions/A/DiskImages2"
        if test "$host_version" != "${host_version#14.}"; then
            replace_file "$compat/IOKit15Compat.dylib" \
                "$runtime/payload/Frameworks/IOKit15Compat.dylib"
        fi
        ;;
esac
chmod 755 \
    "$runtime" \
    "$runtime/install" \
    "$runtime/payload" \
    "$runtime/payload/VirtualMachine.xpc/Contents/MacOS/com.apple.Virtualization.VirtualMachine" \
    "$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation" \
    "$runtime/payload/Installation.xpc/Contents/Frameworks/InstallationCompat.dylib" \
    "$runtime/payload/Installation.xpc/Contents/Frameworks/MobileDevice.framework/Versions/A/Resources/usbmuxd" \
    "$runtime/install/VZHostCompat.dylib" \
    "$runtime/install/install-macos" \
    "$runtime/install/start-install.sh"
chown root:wheel "$runtime/install/install-launcher"
chmod 4755 "$runtime/install/install-launcher"

# Bring a library from before 1.2.4 inside the prefix. Both paths are on the
# data volume, so each entry is a rename: instant, and it needs no free space.
# A name that already exists on this side is left where it is rather than
# overwritten, so the migration can never destroy a virtual machine. Run this
# before the support folders are created, or Restore Images and Installations
# would collide with themselves and be left behind.
if test -d "$legacy_library"; then
    mkdir -p "$library"
    for entry in "$legacy_library"/* "$legacy_library"/.[!.]*; do
        test -e "$entry" || continue
        name="${entry##*/}"
        if test -e "$library/$name"; then
            echo "Virtual Mac: keeping $entry; $library/$name already exists" >&2
            continue
        fi
        mv -f "$entry" "$library/$name" ||
            echo "Virtual Mac: could not move $entry" >&2
    done
    # Succeeds only once everything has moved, so a partial migration leaves
    # the old folder in place with its remaining contents intact.
    rmdir "$legacy_library" 2>/dev/null || true
fi

mkdir -p "$library" "$library/Restore Images" "$library/Installations"
chown mobile:mobile "$library" \
    "$library/Restore Images" "$library/Installations"
chmod 755 "$library" \
    "$library/Restore Images" "$library/Installations"
# Migrated machines already belong to mobile, but one restored from a backup
# may not, and the app runs as mobile.
chown -R mobile:mobile "$library" 2>/dev/null || true

# The only path this package touches above the prefix. Apple's bootpd has its
# lease database compiled in and cannot be pointed inside; postrm deletes it.
mkdir -p /var/db
touch /var/db/dhcpd_leases
chown root:wheel /var/db/dhcpd_leases
chmod 644 /var/db/dhcpd_leases

# Dopamine keys its trust cache on the CDHash rather than the path, so the
# manifest generated at build time stays valid wherever the prefix is mounted.
while IFS="$(printf '\t')" read -r hash file; do
    test -n "$hash"
    test -f "$file"
    "$jbctl" trustcache add "$hash"
done <"$prefix/usr/share/VirtualMac/trustcache.txt"

for domain in system user/501; do
    "$launchctl" bootout "$domain/vzi.apple.bootpd-controller" 2>/dev/null || true
    "$launchctl" bootout "$domain/vzi.apple.bootpd" 2>/dev/null || true
    "$launchctl" bootout "$domain/com.apple.NetworkSharing" 2>/dev/null || true
done
# iPadOS 15 has no launchd user/501 domain.  Keep the established iPadOS 16
# foreground-user placement unchanged, but use the system domain on older
# hosts (both jobs already declare UserName=root).
network_domain=user/501
case "$host_version" in
    14.*) network_domain=system ;;
    15.*) network_domain=system ;;
esac
if test "$host_version" != "${host_version#14.}"; then
    # Avoid opening UDP/67 before the configuration exists. NetworkSharing is
    # started before vmnet because iPadOS 14 cannot resolve this private
    # system-domain Mach service on demand. It writes the config when the VMM
    # attaches its NIC; the controller then enables the private socket job.
    # launchd enable/disable overrides survive a job reload, so explicitly
    # clear a prior development package's enable. The controller loads the
    # private job later, when InternetSharing has written its config.
    "$launchctl" disable "$network_domain/vzi.apple.bootpd"
    rm -f /tmp/bootpd.plist
    "$launchctl" bootstrap "$network_domain" \
        "$launch_daemons/vzi.apple.bootpd-controller.plist"
    "$launchctl" bootstrap "$network_domain" \
        "$launch_daemons/com.apple.NetworkSharing.plist"
    "$launchctl" kickstart -k \
        "$network_domain/com.apple.NetworkSharing"
else
    "$launchctl" bootstrap "$network_domain" \
        "$launch_daemons/com.apple.NetworkSharing.plist"
    "$launchctl" kickstart -k "$network_domain/com.apple.NetworkSharing"
    # Keep the established iPadOS 15/16 behavior, where the helper does not
    # enter the iPadOS 14 missing-configuration socket retry loop.
    "$launchctl" enable "$network_domain/vzi.apple.bootpd"
    "$launchctl" bootstrap "$network_domain" \
        "$launch_daemons/com.apple.bootpd.plist"
fi

"$uicache" -p "$app"

# dpkg's obsolete-directory pass has finished, so the marker preinst used to
# protect root's home is no longer needed. With it gone, nothing this package
# created remains under /var/root.
rm -f /var/root/.virtualmac-preserve-root 2>/dev/null || true

# Sileo passes its result descriptor and protocol version through $CYDIA.
# Stdout is only a log stream and does not create a Restart SpringBoard action.
if test -n "${CYDIA:-}"; then
    read -r finish_fd finish_version <<EOF
$CYDIA
EOF
    case "$finish_fd" in
        ''|*[!0-9]*) ;;
        *)
            if test "${finish_version:-0}" -ge 1 2>/dev/null; then
                echo "finish:restart" >&$finish_fd
            fi
            ;;
    esac
else
    echo "finish:restart"
fi

exit 0
